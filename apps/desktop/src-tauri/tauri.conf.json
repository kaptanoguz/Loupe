{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loupe Photos",
  "mainBinaryName": "loupe-photos",
  "version": "0.3.3",
  "identifier": "app.loupe.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Loupe",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0a0a0a",
        "dragDropEnabled": false,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' thumb: http://thumb.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Photography",
    "shortDescription": "Local-first photo catalog",
    "longDescription": "Loupe keeps your photos on your own disks, runs face recognition and semantic search offline, and receives photos from your phone over Wi-Fi without installing an app.",
    "publisher": "Loupe",
    "copyright": "© 2026 Loupe contributors",
    "homepage": "https://github.com/kaptanoguz/Loupe",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "graphics",
        "priority": "optional",
        "conflicts": [
          "loupe (<< 1.0)"
        ],
        "replaces": [
          "loupe (<< 1.0)"
        ],
        "recommends": [
          "libvips-tools",
          "ffmpeg",
          "gnome-keyring"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
